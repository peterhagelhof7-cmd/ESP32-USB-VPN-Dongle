# PlatformIO / ESP-IDF Build-Artefakte
.pio/
firmware/.pio/
firmware/managed_components/
firmware/dependencies.lock
firmware/sdkconfig.*
!firmware/sdkconfig.defaults
# target-spezifische Defaults (z.B. sdkconfig.defaults.esp32s3) sind Quelle -> tracken.
# Die generierten per-Env-Dateien (sdkconfig.<env>) bleiben ignoriert.
!firmware/sdkconfig.defaults.*
firmware/build/

# Editor
.vscode/
*.swp

# Geheimnisse - NIEMALS committen (WireGuard-Keys etc.)
*.conf
wg_config.conf
