# --- Flash / Partitionen ---
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# --- TinyUSB: USB-Netzwerkklasse NCM (treiberlos auf modernem Windows/macOS) ---
CONFIG_TINYUSB_NET_MODE_NCM=y
# CDC-ACM zusaetzlich (Composite): serielle Log-Konsole ueber USB (Diagnose).
CONFIG_TINYUSB_CDC_ENABLED=y
CONFIG_TINYUSB_CDC_COUNT=1

# --- lwIP: DHCP-Server + IP-Weiterleitung (spaeter fuer NAT/Routing) ---
CONFIG_LWIP_IP_FORWARD=y
CONFIG_LWIP_IPV4_NAPT=y
CONFIG_LWIP_DHCPS=y

# Etwas groesserer Systemtask-Stack (USB + Netif-Callbacks)
CONFIG_ESP_MAIN_TASK_STACK_SIZE=4096

# --- OTA: App-Rollback (fehlerhaftes Update -> Bootloader kehrt zurueck) ---
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# --- DIAGNOSE: Core-Dump ins Flash (Backtrace bei Crash lesbar) ---
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y
CONFIG_ESP_COREDUMP_DATA_FORMAT_ELF=y
CONFIG_ESP_COREDUMP_CHECKSUM_CRC32=y
