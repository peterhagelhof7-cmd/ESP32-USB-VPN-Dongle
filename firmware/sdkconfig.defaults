# --- Flash / Partitionen ---
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# --- TinyUSB: USB-Netzwerkklasse NCM (treiberlos auf modernem Windows/macOS) ---
CONFIG_TINYUSB_NET_MODE_NCM=y

# --- lwIP: DHCP-Server + IP-Weiterleitung (spaeter fuer NAT/Routing) ---
CONFIG_LWIP_IP_FORWARD=y
CONFIG_LWIP_IPV4_NAPT=y
CONFIG_LWIP_DHCPS=y

# Etwas groesserer Systemtask-Stack (USB + Netif-Callbacks)
CONFIG_ESP_MAIN_TASK_STACK_SIZE=4096
