# --- Flash / Partitionen ---
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# --- TinyUSB: USB-Netzwerkklasse NCM (treiberlos auf modernem Windows/macOS) ---
CONFIG_TINYUSB_NET_MODE_NCM=y
# CDC-ACM-Konsole AUS -> NCM-Einzelfunktion. Ein NCM+CDC-ACM-Composite (CDC als
# Interface 0 vor NCM) bindet der NCM-Treiber von macOS/iPadOS NICHT -> Geraet
# wird dort nur als rohes Espressif-USB-Device erkannt, kein Netzadapter.
# NCM-only ist auf Windows + macOS + iPadOS treiberlos verifiziert.
# Kostet die serielle Log-Konsole (COM10). Fuer Debug wieder auf y setzen
# (ACHTUNG PlatformIO-Falle: geaenderte sdkconfig.defaults werden nur bei
# FEHLENDER sdkconfig.<env> angewandt -> vorher firmware/sdkconfig.lolin_s2_mini
# loeschen, sonst greift die Aenderung nicht).
CONFIG_TINYUSB_CDC_ENABLED=n

# --- lwIP: DHCP-Server + IP-Weiterleitung (spaeter fuer NAT/Routing) ---
CONFIG_LWIP_IP_FORWARD=y
CONFIG_LWIP_IPV4_NAPT=y
CONFIG_LWIP_DHCPS=y

# Groesserer Main-Task-Stack: der Heartbeat startet WireGuard (esp_wireguard_init
# macht DNS-Aufloesung + Krypto) -> 4096 reicht nicht (wie ESP-BMC).
CONFIG_ESP_MAIN_TASK_STACK_SIZE=16384

# WICHTIG fuer WireGuard: droscy/esp_wireguard legt sein netif per rohem
# lwIP netif_add() an (netif->state = wireguardif). Ohne diese Option nutzt
# esp_netif netif->state zur esp_netif-Zuordnung -> der globale DHCP-Callback
# haelt das WG-netif faelschlich fuer ein esp_netif und crasht (LoadProhibited).
# ESP_NETIF_BRIDGE_EN schaltet LWIP_ESP_NETIF_DATA=1 -> esp_netif nutzt
# netif->client_data, das WG-netif liefert dort NULL und wird sauber uebersprungen.
CONFIG_ESP_NETIF_BRIDGE_EN=y

# --- OTA: App-Rollback (fehlerhaftes Update -> Bootloader kehrt zurueck) ---
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# --- DIAGNOSE: Core-Dump ins Flash (Backtrace bei Crash lesbar) ---
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y
CONFIG_ESP_COREDUMP_DATA_FORMAT_ELF=y
CONFIG_ESP_COREDUMP_CHECKSUM_CRC32=y

# --- Task-Stack-Anzeige im Webinterface (uxTaskGetSystemState) ---
CONFIG_FREERTOS_USE_TRACE_FACILITY=y

# --- Performance (Phase 10): VPN-/Forwarding-Durchsatz ---
# Der VPN-Durchsatz ist krypto-gebunden: WireGuard ChaCha20-Poly1305 laeuft rein
# in Software (der ESP32-S2 hat KEINE ChaCha-Hardwarebeschleunigung) auf EINEM
# Kern zusammen mit USB-NCM + WLAN. Zwei Stellschrauben ohne Heap-Kosten:
#  1) Vollen Takt nutzen (160 -> 240 MHz): +50 % Rechenleistung, ~linear mehr
#     Krypto-Durchsatz.
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
#  2) Compiler von -Og (Debug) auf -O2 (Performance): beschleunigt die
#     Krypto-/Forwarding-Innenschleifen deutlich (kostet Flash/IRAM, kein Heap).
CONFIG_COMPILER_OPTIMIZATION_PERF=y

# lwIP-Hotpath (ip4_forward/NAPT) ins IRAM -> weniger Flash-Cache-Stalls pro
# weitergeleitetem Paket. Kostet IRAM (separater Heap), NICHT den knappen DRAM.
CONFIG_LWIP_IRAM_OPTIMIZATION=y
